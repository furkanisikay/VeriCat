<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Platformdan bağımsız çekirdek: kedi davranışı, fizik, çarpışma, platform üretimi, ayarlar ve ses sentezi.
    Windows'a özgü hiçbir API kullanmaz; bu sayede Linux/macOS üzerinde de test edilebilir.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VeriCat.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VeriCat.Core.Tests" />
  </ItemGroup>

</Project>
